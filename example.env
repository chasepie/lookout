# The username and password you sign in with. The Backend won't start without them, or with a password shorter than
# 12 characters. Changing either signs out every session after a restart. Outside localhost, Lookout must be served over
# HTTPS, or signing in won't work.
LOOKOUT_OWNER_USERNAME=
LOOKOUT_OWNER_PASSWORD=
LOOKOUT_WATCH_SCRIPTS_DIR=
LOOKOUT_DATABASE_DIR=
LOOKOUT_RUNNER_URL=
LOOKOUT_BROWSERLESS_URL=
# The browser connects to this proxy, so it must be reachable from where the browser runs (the AppHost sets it)
LOOKOUT_VPN_PROXY_URL=
# gluetun's control server and its API key, which the Backend switches VPN regions with (the AppHost sets them)
LOOKOUT_GLUETUN_URL=
LOOKOUT_GLUETUN_API_KEY=
# Where gluetun keeps its data, including the VPN servers list the Backend reads regions from.
# Required when the OpenVPN credentials below are set.
LOOKOUT_GLUETUN_DIR=

# Containers the AppHost starts. gluetun (the VPN) only starts when both OpenVPN credentials are set.
TZ=America/New_York
BROWSERLESS_TOKEN=
VPN_SERVICE_PROVIDER=private internet access
OPENVPN_USER=
OPENVPN_PASSWORD=
