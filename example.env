# Lookout's deployment settings, for docker compose (see "Deploying" in README.md). Copy this file to .env beside
# compose.yaml and uncomment what you want to change; every setting here is shown with its default.

# Required: the token Lookout sends the runner with every Script, without which the runner refuses it. Letters,
# digits, '-' and '_' only, such as from openssl rand -hex 32.
LOOKOUT_RUNNER_TOKEN=

# The host port Lookout is served on
# LOOKOUT_PORT=8080

# The time zone schedules use, such as Europe/London. Unset, they use UTC.
# LOOKOUT_TIME_ZONE=

# How many Runs execute at once, and how many browsers Browserless runs at once. Raise both memory limits with it.
# LOOKOUT_MAX_CONCURRENT_RUNS=2

# The runner's memory limit: 640m per concurrent Run, plus 256m for the runner itself
# LOOKOUT_RUNNER_MEMORY=1536m

# Browserless's memory limit: about 1.5g per concurrent Run
# LOOKOUT_BROWSERLESS_MEMORY=3g

# The VPN, which is optional (see "VPN" in README.md). Without it, Watches that use the VPN have their Runs refused.
# To use it, uncomment all of these:

# Runs gluetun and its relay
# COMPOSE_PROFILES=vpn

# The key Lookout uses for gluetun's control server: letters, digits, '-' and '_' only, such as from
# openssl rand -hex 32. Without it, the VPN is disabled.
# LOOKOUT_VPN_API_KEY=

# Your Private Internet Access login for OpenVPN
# PIA_USER=
# PIA_PASSWORD=

# The PIA regions gluetun picks a server from, comma-separated. Keep them in one country, as an exit in another
# changes what retailers serve, which shows up as false Changes.
# LOOKOUT_VPN_REGIONS="US East,US New York,US Florida,US California,US Chicago,US Texas,US Washington DC,US Atlanta"
