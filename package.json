{
  "name": "@chasepie/lookout",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/chasepie/lookout#readme",
  "bugs": {
    "url": "https://github.com/chasepie/lookout/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chasepie/lookout.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/frontend/e2e/tsconfig.json",
    "build:frontend": "npm run build -w src/frontend",
    "test": "npm run test:runner && dotnet test --solution Lookout.slnx && npm run test:e2e",
    "test:runner": "npm test -w src/runner",
    "test:e2e": "npm run build:frontend && npm run e2e -w src/frontend",
    "lint": "eslint ."
  },
  "workspaces": [
    "examples",
    "src/frontend",
    "src/runner",
    "src/scripting"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
