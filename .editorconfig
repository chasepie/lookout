# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,js,mjs,ts,csproj,props}]
indent_size = 2

[src/Database/Migrations/*.cs]
generated_code = true

[*.ts]
quote_type = single
ij_typescript_use_double_quotes = false
