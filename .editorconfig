# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_size = 4

[*.ts]
quote_type = single
ij_typescript_use_double_quotes = false

# EF Core migrations are generated by `dotnet ef migrations add`, so analyzers skip them
[src/Backend/Database/Migrations/*.cs]
generated_code = true
