{
  "name": "@chasepie/lookout-watch-sdk",
  "version": "0.0.0",
  "description": "Write and run Lookout watch scripts: their types, and a CLI that runs one in Chromium",
  "license": "MIT",
  "author": "chasepie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chasepie/lookout.git",
    "directory": "src/watch-sdk"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "lookout-watch": "./dist/cli.js"
  },
  "files": [
    "dist",
    "index.ts"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run clean && npm run build:lib && npm run build:cli",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:cli": "esbuild cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.js --external:playwright",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test 'test/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "commander": "^15.1.0",
    "esbuild": "^0.28.2",
    "rimraf": "^6.1.4",
    "semver": "^7.8.5",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "playwright": "~1.65.0"
  }
}
