{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch API Docs - Backend",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/Backend/Backend.csproj",
      "serverReadyAction": {
        "action": "debugWithChrome",
        "killOnServerStop": true,
        "pattern": "Now listening on: https://localhost:([0-9]+)",
        "uriFormat": "https://localhost:%s/api-docs"
      }
    },
    {
      "name": "Launch API Docs - Runner",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/Runner/Runner.csproj",
      "serverReadyAction": {
        "action": "debugWithChrome",
        "killOnServerStop": true,
        "pattern": "Now listening on: https://localhost:([0-9]+)",
        "uriFormat": "https://localhost:%s/api-docs"
      }
    },
  ]
}
