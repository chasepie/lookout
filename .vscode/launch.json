{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Backend",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/Backend/Backend.csproj",
    },
    {
      "name": "Launch Frontend",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "http://localhost:4200/"
    },
    {
      "name": "Serve Scalar API",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/Backend/Backend.csproj",
      "serverReadyAction": {
        "action": "debugWithChrome",
        "killOnServerStop": true,
        "pattern": "Now listening on: https://localhost:([0-9]+)",
        "uriFormat": "https://localhost:%s/scalar"
      }
    }
  ],
  "compounds": [
    {
      "name": "Launch Backend + Frontend",
      "configurations": [
        "Launch Backend",
        "Launch Frontend"
      ],
      "stopAll": true
    }
  ]
}
