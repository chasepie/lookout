{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Clean Repo",
      "type": "shell",
      "command": [
        "git"
      ],
      "args": [
        "clean",
        "-fdx",
        "--exclude=\".env\"",
        "--exclude=\".claude/settings.local.json\""
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
