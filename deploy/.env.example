# Required: browserless's token, letters and digits only, such as from `openssl rand -hex 32`.
BROWSERLESS_TOKEN=

# Required: the Backend's key for gluetun's control server, letters and digits only, such as from `openssl rand -hex 32`.
GLUETUN_API_KEY=

# The host address the Backend's port is published on: 127.0.0.1 for a reverse proxy on this machine. Default: 127.0.0.1.
LOOKOUT_BIND_ADDRESS=

# browserless's memory limit. Default: 2g.
LOOKOUT_BROWSERLESS_MEMORY=

# Required: the hostname Lookout is served on, such as lookout.example.com. Requests for any other are refused.
LOOKOUT_HOST=

# The tag of the Backend's and the Runner's images: main, a version such as 1.2.0, or sha-<commit>. Default: main.
LOOKOUT_IMAGE_TAG=

# Required: the username the Owner signs in with. The password is in secrets/owner_password.
LOOKOUT_OWNER_USERNAME=

# The host port the Backend is published on. Default: 8080.
LOOKOUT_PORT=

# The Runner's memory limit, which bounds what a script can take. Default: 1g.
LOOKOUT_RUNNER_MEMORY=

# The reverse proxy's address as the Backend sees it, as comma-separated IPs or CIDR networks. Without it, X-Forwarded-For and X-Forwarded-Proto are ignored, and signing in through the proxy fails. Default: none.
LOOKOUT_TRUSTED_PROXIES=

# The time zone of schedules and scripts' dates, such as America/New_York. Default: Etc/UTC.
TZ=

# gluetun's VPN_SERVICE_PROVIDER. Default: private internet access.
VPN_SERVICE_PROVIDER=

