# browserless's memory limit. Default: 2g.
BROWSERLESS_MEMORY=

# Required: browserless's token, such as from `openssl rand -hex 32`.
BROWSERLESS_TOKEN=

# Required: the Backend's key for gluetun's control server, letters and digits only, such as from `openssl rand -hex 32`.
GLUETUN_API_KEY=

# Required: your VPN provider's OpenVPN password. Put it in single quotes if it has $, # or spaces in it.
GLUETUN_OPENVPN_PASSWORD=

# Required: your VPN provider's OpenVPN username. Put it in single quotes if it has $, # or spaces in it.
GLUETUN_OPENVPN_USER=

# Required: the password of gluetun's HTTP proxy, such as from `openssl rand -hex 32`.
GLUETUN_PROXY_PASSWORD=

# The VPN regions to use, as gluetun's SERVER_REGIONS: comma-separated with no spaces around the commas, such as 'DE Berlin,US Texas'. gluetun connects to one of them, and the Backend switches and rotates only among them. Without it, every region of the provider. Default: none.
GLUETUN_SERVER_REGIONS=

# gluetun's VPN_SERVICE_PROVIDER. Default: private internet access.
GLUETUN_VPN_SERVICE_PROVIDER=

# The host address the Backend's port is published on: 127.0.0.1 for a reverse proxy on this machine. Default: 127.0.0.1.
LOOKOUT_BIND_ADDRESS=

# The subnet of the Backend's edge network, where its published port's connections come from; its gateway is the subnet's first address, 172.30.240.1 by default. Fixed, so the gateway stays the same when the network is re-created. Change it if it overlaps another network on this machine. Default: 172.30.240.0/24.
LOOKOUT_EDGE_SUBNET=

# Required: the hostname Lookout is served on, such as lookout.example.com. Requests for any other are refused.
LOOKOUT_HOST=

# Required: the tag of the Backend's and the Runner's images: a release's major version, such as 1, or before 1.0 its minor version, such as 0.4, to follow its updates; or a version, such as 0.4.3, to stay on it.
LOOKOUT_IMAGE_TAG=

# How many watch runs Lookout runs at once at most, each of a different watch; browserless runs as many browser sessions at once. Each takes memory in browserless and the Runner, so raise BROWSERLESS_MEMORY and LOOKOUT_RUNNER_MEMORY with it. Default: 3.
LOOKOUT_MAX_CONCURRENT_RUNS=

# Required: the password the Owner signs in with, at least 16 characters. Changing it signs out every session. Put it in single quotes if it has $, # or spaces in it.
LOOKOUT_OWNER_PASSWORD=

# Required: the username the Owner signs in with.
LOOKOUT_OWNER_USERNAME=

# The host port the Backend is published on. Default: 8080.
LOOKOUT_PORT=

# Required: the key the Backend sends the Runner, such as from `openssl rand -hex 32`.
LOOKOUT_RUNNER_API_KEY=

# The Runner's memory limit, which bounds what a script can take. Default: 1g.
LOOKOUT_RUNNER_MEMORY=

# The reverse proxy's address as the Backend sees it, as comma-separated IPs or CIDR networks. Without it, X-Forwarded-For and X-Forwarded-Proto are ignored, and signing in through the proxy fails. Default: none.
LOOKOUT_TRUSTED_PROXIES=

# The time zone of schedules and scripts' dates, such as America/New_York. Default: Etc/UTC.
TZ=

